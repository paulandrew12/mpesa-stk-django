# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Safaricom Daraja credentials
# Get these at https://developer.safaricom.co.ke — create an app under
# "Lipa Na M-Pesa Online". Sandbox approval is instant.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox defaults published by Safaricom. Replace both with your own
# Till/Paybill values in production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# ---------------------------------------------------------------------------
# Callback URL — must be publicly reachable over HTTPS.
# Local: npx ngrok http 8000, then paste the https URL here.
# ---------------------------------------------------------------------------
MPESA_CALLBACK_BASE_URL=

# Enables /api/dev/simulate-callback/ so the flow can be demoed without a
# tunnel. MUST be false in production.
ALLOW_SIMULATION=true
